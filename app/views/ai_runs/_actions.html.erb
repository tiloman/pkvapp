<div class="d-flex flex-wrap gap-2 align-items-center">
  <% providers = ai_provider_options(current_user) %>
  <%= form_with url: retry_ai_run_path(run), method: :post, local: true, class: 'd-flex gap-2 align-items-center m-0' do %>
    <% if providers.size > 1 %>
      <%# forms.scss gives every .form-select height 3rem and a bottom margin; reset both for this compact row %>
      <%= select_tag :provider, options_for_select(providers, run.provider), class: 'form-select form-select-sm w-auto h-auto mb-0' %>
    <% end %>
    <%= button_tag 'Erneut analysieren', type: 'submit', class: 'btn btn-outline-primary btn-sm' %>
  <% end %>
  <%= button_to 'Verwerfen', reject_ai_run_path(run), method: :post, class: 'btn btn-outline-danger btn-sm',
                form: { class: 'm-0', data: { confirm: 'Vorschlag verwerfen?' } } %>
</div>
